# ==========================================
# Frontend (.env at repo root) — for Vercel deployment
# ==========================================
CI=false
GENERATE_SOURCEMAP=false
# Backend API URL (Render deployment). Defaults to localhost for dev.
REACT_APP_API_URL=https://checkin-backend.onrender.com
# Base URL used to build the QR check-in link shown to employees
REACT_APP_QR_BASE_URL=https://checkin.vercel.app

# ==========================================
# Backend (.env in backend/ or Render env vars) — for Render deployment
# ==========================================
DATABASE_URL=sqlite:////var/tmp/checkin.db
SECRET_KEY=change-this-in-production
ALLOWED_ORIGINS=https://checkin.vercel.app,http://localhost:3000
PORT=8000
